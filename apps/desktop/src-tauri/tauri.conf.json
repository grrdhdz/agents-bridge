{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "agents-bridge",
  "version": "0.5.2",
  "identifier": "dev.grrdhdz.agents-bridge",
  "build": {
    "beforeDevCommand": "npm run sidecar && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run sidecar && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "agents-bridge",
        "width": 880,
        "height": 680,
        "minWidth": 400,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "externalBin": [
      "binaries/agents-bridge"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "grrdhdz",
    "shortDescription": "Conversaciones y coordinación entre agentes",
    "longDescription": "Cliente de escritorio de agents-bridge: observa puentes efímeros, conversa y coordina agentes a través de la API pública del motor.",
    "category": "DeveloperTool",
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}

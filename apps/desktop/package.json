{
  "name": "agents-bridge-desktop",
  "version": "0.5.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && node scripts/check-production.mjs",
    "sidecar": "node scripts/sidecar.mjs",
    "generate:types": "node scripts/types.mjs",
    "check:types": "node scripts/types.mjs --check",
    "test": "npm run sidecar && node --test scripts/*.test.mjs && vitest run",
    "tauri": "tauri",
    "smoke:native": "node scripts/native-smoke.mjs",
    "typecheck": "npm run check:types && tsc --noEmit",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.50.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "json-schema-to-typescript": "^16.0.0",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}

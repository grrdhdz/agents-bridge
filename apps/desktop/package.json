{
  "name": "agents-bridge-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:types && tsc --noEmit && vite build",
    "sidecar": "node scripts/sidecar.mjs",
    "generate:types": "node scripts/types.mjs",
    "check:types": "node scripts/types.mjs --check",
    "test": "npm run sidecar && node --test scripts/*.test.mjs && vitest run",
    "tauri": "tauri",
    "smoke:native": "node scripts/native-smoke.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
